{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal do Tropicalia Launcher",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }]
    },
    "store:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://login.microsoftonline.com/*" },
        { "url": "https://user.auth.xboxlive.com/*" },
        { "url": "https://xsts.auth.xboxlive.com/*" },
        { "url": "https://api.minecraftservices.com/*" },
        { "url": "https://piston-meta.mojang.com/*" },
        { "url": "https://launchermeta.mojang.com/*" },
        { "url": "https://api.modrinth.com/*" },
        { "url": "https://meta.fabricmc.net/*" },
        { "url": "https://meta.quiltmc.org/*" },
        { "url": "https://maven.neoforged.net/*" },
        { "url": "https://files.minecraftforge.net/*" },
        { "url": "https://maven.minecraftforge.net/*" },
        { "url": "https://fill.papermc.io/*" },
        { "url": "https://api.papermc.io/*" },
        { "url": "https://hangar.papermc.io/*" },
        { "url": "https://api.purpurmc.org/*" },
        { "url": "https://api.mohistmc.com/*" },
        { "url": "https://mohistmc.com/*" },
        { "url": "https://api.github.com/*" },
        { "url": "https://api.mcsrvstat.us/*" },
        { "url": "https://tropicaliacraft.online/*" },
        { "url": "https://*.tropicaliacraft.online/*" },
        { "url": "http://localhost:*/*" }
      ]
    }
  ]
}
