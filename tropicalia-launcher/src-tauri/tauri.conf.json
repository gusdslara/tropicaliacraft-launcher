{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TropicaliaLauncher",
  "version": "0.1.0",
  "identifier": "com.tropicaliacraft.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TropicaliaLauncher",
        "width": 1220,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0d1210"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Launcher de Minecraft do TropicaliaCraft",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "20EDB49E-4BFA-53EF-BFAA-688C6FD5DF68"
      },
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
